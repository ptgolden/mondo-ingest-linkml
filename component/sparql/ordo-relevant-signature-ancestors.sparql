# Named ancestors of ordo-relevant-signature.sparql's roots (in practice just
# Orphanet:C001). They stay in the component as referenced classes, so their own
# annotations are kept when the out-of-signature classes' annotations are removed.
prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT DISTINCT ?term
WHERE {
  VALUES ?ordo_roots {<http://www.orpha.net/ORDO/Orphanet_557493> <http://www.orpha.net/ORDO/Orphanet_557492> <http://www.orpha.net/ORDO/Orphanet_557494> <http://www.orpha.net/ORDO/Orphanet_C041>}
  ?ordo_roots rdfs:subClassOf+ ?term .
  FILTER(isIRI(?term))
}
