# -> Term.consider: ORDO's "Referred to" (C057) suggests a target without claiming replacement.
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT DISTINCT ?id ?consider
WHERE {
  ?id <https://w3id.org/monarch-initiative/mondo-ingest-ordo/in_scope> ?in ;
      rdfs:subClassOf [ owl:onProperty <http://www.orpha.net/ORDO/Orphanet_C057> ; owl:someValuesFrom ?consider ] .
}
ORDER BY ?id ?consider
