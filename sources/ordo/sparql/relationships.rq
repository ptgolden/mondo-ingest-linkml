# -> Term.relationships: disease -> HGNC gene, from ORDO's gene -> disease relations
# (mondo-ingest's ordo-construct-d2g.ru, turned around onto the disease).
#
# Orphanet:410295 is the loss-of-function relation and maps to RO:0004002;
# mondo-ingest maps it to RO:0004001, the gain-of-function one
# (MONDO-INGEST-BUGS.md, bug 4).
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX oio: <http://www.geneontology.org/formats/oboInOwl#>
PREFIX Orphanet: <http://www.orpha.net/ORDO/Orphanet_>
PREFIX RO: <http://purl.obolibrary.org/obo/RO_>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?id ?predicate ?target
WHERE {
  VALUES (?ordoRel ?predicate) {
    ( Orphanet:410295 RO:0004002 )
    ( Orphanet:410296 RO:0004001 )
    ( Orphanet:317343 RO:0004003 )
    ( Orphanet:317344 RO:0004004 )
  }
  ?gene rdfs:subClassOf [ owl:onProperty ?ordoRel ; owl:someValuesFrom ?id ] ;
        oio:hasDbXref ?x ;
        rdfs:subClassOf+ Orphanet:C010 .
  ?id <https://w3id.org/monarch-initiative/mondo-source/in_scope> ?in ;
      rdfs:label ?diseaseLabel ;
      rdfs:subClassOf+ Orphanet:C001 .
  # ORDO's gene xrefs are "HGNC:N" strings, typed xsd:anyURI to mark them as identifiers.
  FILTER(STRSTARTS(STR(?x), "HGNC:"))
  BIND(STRDT(STR(?x), xsd:anyURI) AS ?target)
}
ORDER BY ?id ?predicate ?target
