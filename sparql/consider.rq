# -> Term.consider. ORDO's "Referred to" (C057) suggests a target without claiming replacement.
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT DISTINCT ?id ?consider
WHERE {
  ?c <https://w3id.org/monarch-initiative/mondo-ingest-ordo/in_scope> ?in .
  ?c rdfs:subClassOf [ owl:onProperty <http://www.orpha.net/ORDO/Orphanet_C057> ; owl:someValuesFrom ?t ] .
  BIND(CONCAT("Orphanet:", STRAFTER(STR(?c), "http://www.orpha.net/ORDO/Orphanet_")) AS ?id)
  BIND(CONCAT("Orphanet:", STRAFTER(STR(?t), "http://www.orpha.net/ORDO/Orphanet_")) AS ?consider)
}
