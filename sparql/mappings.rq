# -> Term.mappings: ORDO's qualified xrefs from in-scope terms.
#
# Predicate comes from ORDO's own precision code (ECO_0000218 axiom annotation),
# which ORDO defines relative to the ORPHAcode:
#   E    -> skos:exactMatch
#   NTBT -> skos:broadMatch   (ORPHAcode narrower than target, so target is broader)
#   BTNT -> skos:narrowMatch
# ND-qualified and unqualified xrefs are not taken in (as in mondo-ingest).
#
# For ICD targets the qualifier has a second line, the code-relation type
# (Specific code / Attributed code / Index term / Inclusion term), which SSSOM has
# no slot for. It goes into ?comment, minus the leading "- " and final ".".
#
# ORDO's xref targets are "PREFIX:local" strings, returned typed xsd:anyURI to mark
# them as identifiers. The assembler standardises them with config/prefixes.yaml,
# where ORDO's own spellings ("ICD-10", "MeSH", ...) are synonyms of mondo-ingest's
# prefixes; an unknown prefix fails.
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX oio: <http://www.geneontology.org/formats/oboInOwl#>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX semapv: <https://w3id.org/semapv/vocab/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?id ?predicate_id ?object_id ?mapping_justification ?comment
WHERE {
  ?id <https://w3id.org/monarch-initiative/mondo-ingest-ordo/in_scope> ?in ;
      oio:hasDbXref ?x .
  ?ax owl:annotatedSource ?id ;
      owl:annotatedProperty oio:hasDbXref ;
      owl:annotatedTarget ?x ;
      obo:ECO_0000218 ?q .

  # Strip the leading "- " that multi-line qualifiers use, then read the code.
  BIND(REPLACE(STR(?q), "^- ", "") AS ?qs)
  BIND(
    IF(STRSTARTS(?qs, "E "), skos:exactMatch,
    IF(STRSTARTS(?qs, "NTBT "), skos:broadMatch,
    IF(STRSTARTS(?qs, "BTNT "), skos:narrowMatch,
    IF(STRSTARTS(?qs, "ND "), ?unbound,
       "UNRECOGNISED_QUALIFIER"))))
    AS ?predicate_id)
  FILTER(BOUND(?predicate_id))
  BIND(semapv:ManualMappingCuration AS ?mapping_justification)
  BIND(IF(CONTAINS(STR(?q), "\n- "), REPLACE(STRAFTER(STR(?q), "\n- "), "\\.$", ""), ?unbound) AS ?comment)

  # ORDO 4.9 has a handful of ICD-11 xrefs with stray non-breaking spaces
  # (e.g. "ICD-11: 4A6Y"); mondo-ingest's fix_xref_prefixes.ru meant to strip them.
  BIND(REPLACE(STR(?x), " ", "") AS ?xs)
  BIND(STRDT(?xs, xsd:anyURI) AS ?object_id)
}
ORDER BY ?id STR(?object_id) ?predicate_id ?comment
