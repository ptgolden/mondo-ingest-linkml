# -> Term.parents: named superclasses, which after 00-part-of-as-parents.ru include
# ORDO's part_of targets.
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT DISTINCT ?id ?parents
WHERE {
  ?c <https://w3id.org/monarch-initiative/mondo-ingest-ordo/in_scope> ?in ;
     rdfs:subClassOf ?p .
  FILTER(isIRI(?p) && STRSTARTS(STR(?p), "http://www.orpha.net/ORDO/Orphanet_"))
  BIND(CONCAT("Orphanet:", STRAFTER(STR(?c), "http://www.orpha.net/ORDO/Orphanet_")) AS ?id)
  BIND(CONCAT("Orphanet:", STRAFTER(STR(?p), "http://www.orpha.net/ORDO/Orphanet_")) AS ?parents)
}
