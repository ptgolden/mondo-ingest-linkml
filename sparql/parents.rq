# -> Term.parents: named superclasses, which after 00-part-of-as-parents.ru include
# ORDO's part_of targets.
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT DISTINCT ?id ?parents
WHERE {
  ?id <https://w3id.org/monarch-initiative/mondo-ingest-ordo/in_scope> ?in ;
      rdfs:subClassOf ?parents .
  FILTER(isIRI(?parents) && STRSTARTS(STR(?parents), "http://www.orpha.net/ORDO/Orphanet_"))
}
