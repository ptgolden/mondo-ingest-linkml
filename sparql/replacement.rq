# -> Term.replaced_by. ORDO defines "Moved to" (C056) as redirection to a code of replacement.
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT DISTINCT ?id ?replaced_by
WHERE {
  ?c rdfs:subClassOf [ owl:onProperty <http://www.orpha.net/ORDO/Orphanet_C056> ; owl:someValuesFrom ?t ] .
  BIND(CONCAT("Orphanet:", STRAFTER(STR(?c), "http://www.orpha.net/ORDO/Orphanet_")) AS ?id)
  BIND(CONCAT("Orphanet:", STRAFTER(STR(?t), "http://www.orpha.net/ORDO/Orphanet_")) AS ?replaced_by)
}
