# -> Term.synonyms, all EXACT:
# - ORDO's alternative terms (unscoped in ORDO; Mondo reads them as EXACT, as
#   mondo-ingest's property map does);
# - each non-deprecated term's label, typed mondo:GENERATED_FROM_LABEL
#   (mondo-ingest's exact_syn_from_label.ru);
# - for labels and synonyms ending in ")" or "]", the lowercased text with the final
#   bracketed part removed, typed mondo:GENERATED (mondo-ingest's
#   fix-labels-with-brackets.ru).
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX efo: <http://www.ebi.ac.uk/efo/>
SELECT DISTINCT ?id ?text ?scope ?synonym_type
WHERE {
  ?c <https://w3id.org/monarch-initiative/mondo-ingest-ordo/in_scope> ?in .
  {
    ?c efo:alternative_term ?s .
    BIND(STR(?s) AS ?text)
  } UNION {
    ?c rdfs:label ?l .
    FILTER NOT EXISTS { ?c owl:deprecated ?d }
    FILTER NOT EXISTS { ?c rdfs:subClassOf* <http://www.orpha.net/ORDO/Orphanet_C041> }
    BIND(STR(?l) AS ?text)
    BIND("mondo:GENERATED_FROM_LABEL" AS ?synonym_type)
  } UNION {
    { ?c rdfs:label ?v } UNION { ?c efo:alternative_term ?v }
    FILTER(REGEX(STR(?v), "[\\])]$"))
    BIND(REPLACE(LCASE(STR(?v)), " [\\[(].*[)\\]]$", "") AS ?text)
    BIND("mondo:GENERATED" AS ?synonym_type)
  }
  BIND(CONCAT("Orphanet:", STRAFTER(STR(?c), "http://www.orpha.net/ORDO/Orphanet_")) AS ?id)
  BIND("EXACT" AS ?scope)
}
