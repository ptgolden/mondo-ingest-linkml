# One row per in-scope class. -> Term
# Labels: 4.9 has a few classes with both "X" and "X"@en; STR + DISTINCT collapses them.
# Deprecated: owl:deprecated (ORDO 4.9), or anything under Inactive clinical entity
# (C041), including C041 and its own category classes, as mondo-ingest's
# fix_deprecated.ru does. ORDO's free-text reason_for_inactivation is not taken in.
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT DISTINCT ?id ?label ?deprecated
WHERE {
  ?id <https://w3id.org/monarch-initiative/mondo-ingest-ordo/in_scope> ?in ;
      rdfs:label ?l .
  BIND(STR(?l) AS ?label)
  OPTIONAL { ?id owl:deprecated ?d }
  BIND(IF(BOUND(?d) || EXISTS { ?id rdfs:subClassOf* <http://www.orpha.net/ORDO/Orphanet_C041> }, true, ?unbound)
       AS ?deprecated)
}
