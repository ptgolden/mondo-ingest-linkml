# One row per ORDO class, single-valued fields only. -> Term
# Labels: 4.9 has a few classes with both "X" and "X"@en; STR + DISTINCT collapses them.
# Labels are kept verbatim (including "OBSOLETE: " prefixes); stripping is hub policy.
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX efo: <http://www.ebi.ac.uk/efo/>
SELECT DISTINCT ?id ?label ?deprecated ?obsoletion_reason
WHERE {
  ?c a owl:Class ;
     rdfs:label ?l .
  FILTER(STRSTARTS(STR(?c), "http://www.orpha.net/ORDO/Orphanet_"))
  BIND(CONCAT("Orphanet:", STRAFTER(STR(?c), "http://www.orpha.net/ORDO/Orphanet_")) AS ?id)
  BIND(STR(?l) AS ?label)
  OPTIONAL { ?c efo:reason_for_inactivation ?r BIND(STR(?r) AS ?obsoletion_reason) }

  # ORDO 4.9 states owl:deprecated; 4.7 only placed inactive terms under "Inactive
  # clinical entity" (C041) with a reason_for_inactivation. Accept either. Requiring
  # the reason excludes ORDO's own category classes under C041 ("Obsolete disorder"
  # etc.), which mondo-ingest's fix_deprecated.ru marks deprecated too.
  OPTIONAL { ?c owl:deprecated ?d }
  BIND(IF(BOUND(?d), STR(?d),
          IF(BOUND(?r) && EXISTS { ?c rdfs:subClassOf+ <http://www.orpha.net/ORDO/Orphanet_C041> }, "true", ?unbound))
       AS ?deprecated)
}
